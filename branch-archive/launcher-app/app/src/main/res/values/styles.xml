<?xml version="1.0" encoding="utf-8"?>
<resources><style name="AppTheme" parent="@android:style/Theme.Material.NoActionBar">
    <item name="android:fontFamily">sans</item><item name="android:colorAccent">#7C9CFF</item>
    <item name="android:statusBarColor">#121620</item><item name="android:navigationBarColor">#121620</item>
    <item name="android:windowLightStatusBar">false</item>
    <item name="android:windowAnimationStyle">@style/LauncherWindowAnimations</item>
</style>
<style name="LauncherWindowAnimations" parent="@android:style/Animation.Activity">
    <!-- Keep Home/task-opening transitions visually consistent with the working Back close transition. -->
    <item name="android:activityOpenEnterAnimation">@anim/launcher_task_close_enter</item>
    <item name="android:activityOpenExitAnimation">@anim/launcher_task_close_exit</item>
    <item name="android:taskOpenEnterAnimation">@anim/launcher_task_close_enter</item>
    <item name="android:taskOpenExitAnimation">@anim/launcher_task_close_exit</item>
    <item name="android:activityCloseEnterAnimation">@anim/launcher_task_close_enter</item>
    <item name="android:activityCloseExitAnimation">@anim/launcher_task_close_exit</item>
    <item name="android:taskCloseEnterAnimation">@anim/launcher_task_close_enter</item>
    <item name="android:taskCloseExitAnimation">@anim/launcher_task_close_exit</item>
</style>
</resources>